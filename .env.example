# Reddit OAuth Script Authorization Credentials
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..." at the bottom
# 3. Select "script" (personal use script)
# 4. Fill in:
#    - name: SocialsDash
#    - redirect uri: http://localhost:5000
# 5. Copy your Client ID (under the app name) and Secret

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=SocialsDash:1.0 (personal reading tool by /u/your_reddit_username)

# Optional Server Port (default: 5000)
PORT=5000
